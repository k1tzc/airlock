# Lista de identificadores de airlock. El archivo real NO va en el repo:
#   seguridad normal → ~/.config/airlock/identificadores
#   máxima           → /etc/claude-code/airlock/identificadores (solo root lo cambia)
# Un valor por línea. Mayúsculas, espacios y guiones no importan:
# "Mi Proyecto" también casa con "mi-proyecto" y "MiProyecto".

[siempre]
# Nunca en ninguna herramienta: comandos, archivos, web, commits.
tu.correo@ejemplo.com

[externo]
# Nunca hacia terceros (web, MCP, User-Agent, curl/wget). Sí en tu código y tus repos.
Tu Nombre Completo
Nombre del Cliente
Nombre del Proyecto

[propios]
# Tus dominios: ahí sí pueden aparecer (deploy, staging, ssh a tu servidor).
tudominio.com
